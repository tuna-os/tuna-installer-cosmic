<component type="desktop-application">
  <id>org.tunaos.InstallerCosmic</id>

  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>

  <name>Install TunaOS</name>
  <summary>Set up TunaOS on this computer</summary>

  <description>
    <p>
      The COSMIC front-end for the TunaOS installer. It walks through
      picking a disk, choosing whether to encrypt it, and writing the system
      image, then hands over to a first boot of TunaOS.
    </p>
    <p>
      Installation itself is carried out by the fisherman bootc backend, so
      every desktop front-end installs exactly the same system.
    </p>
    <p>
      This front-end comes preinstalled on the TunaOS COSMIC live image. You
      do not normally need to install it by hand.
    </p>
  </description>

  <developer id="org.tunaos">
    <name>TunaOS</name>
  </developer>

  <launchable type="desktop-id">org.tunaos.InstallerCosmic.desktop</launchable>

  <!--
    These PNGs are regenerated and committed by
    .github/workflows/screenshots.yml on every push to main, straight from the
    real UI, so the URLs below always show the current app. Do not hand-edit
    the images; change the capture harness instead.
  -->
